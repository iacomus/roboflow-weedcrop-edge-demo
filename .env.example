# Roboflow credentials template — copy to .env and fill in
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your actual values
#
# The .env file is gitignored (via *.env in .gitignore) — never commit secrets.
# This .env.example file IS tracked in git as the reference template.
#
# Note: the iOS app does NOT read .env at runtime — it uses hardcoded values
# in ios/Roboflow Starter Project/ViewController.swift. The .env file is a
# memory aid for the values you'll need to paste into Swift code.

# Roboflow API key (Settings → API Keys → Private API Key)
# Format: 40-char alphanumeric string
ROBOFLOW_API_KEY=your_private_api_key_here

# Your workspace URL slug — appears in roboflow.com/<workspace>/<project> URLs
ROBOFLOW_WORKSPACE=your_workspace_slug

# Project ID — the slug for the forked dataset
# Find in URL: universe.roboflow.com/<workspace>/<PROJECT_ID>
ROBOFLOW_PROJECT_ID=

# Model version — generated dataset version, usually starts at 1
ROBOFLOW_MODEL_VERSION=

# Trained model metadata — filled after training completes
ROBOFLOW_MODEL_ARCHITECTURE=
ROBOFLOW_MODEL_MAP50=
ROBOFLOW_TRAINING_TIME_MIN=
ROBOFLOW_MODEL_SIZE_MB=

# iPhone observed FPS — filled after model loaded on device
IPHONE_INFERENCE_FPS=
