# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/
DerivedData/
*.moved-aside
*.xcscmblueprint
*.xccheckout

# CocoaPods — ignore Pods source anywhere in the tree (regenerable via `pod install`)
# Podfile + Podfile.lock ARE committed for reproducibility
**/Pods/
ios/Podfile.lock

# Swift Package Manager
.swiftpm/
Package.resolved

# Secrets — never commit API keys
*.env
*.secret
APIKey.swift
**/Secrets.swift

# Build artifacts
build/
*.ipa
*.dSYM.zip
*.dSYM

# Editor
.vscode/
.idea/
*.swp

# Skill / agent-tool internal artifacts — DO NOT COMMIT
# Brainstorming specs, plans, and other internal planning docs may
# reference customer names or other content excluded from the public repo.
CLAUDE.md
docs/
.claude/
.cursor/
.aider*
*.skill-cache

# Local training artifacts (heavy — not committed)
training/.venv/
training/dataset/
training/output/
training/runs/
training/*.pt
training/*.pth
training/*.mlpackage
training/*.mlmodel
training/*.log
training/*.pid
training/*.onnx
training/colab/
training/export/
training/**/*.pth
training/**/*.onnx
training/**/*.mlpackage
training/test_output/

# Visual brainstorming companion (local only)
.superpowers/
